module(
    name = "someip_proto",
    version = "0.1.0",
    compatibility_level = 0,
)

bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "36.2", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_proto", version = "7.1.0")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.73.0")
use_repo(buf, "rules_buf_toolchains")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "org_golang_google_protobuf")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.host(name = "someip_proto_host_sdk", version = "1.27.1")
use_repo(go_sdk, "someip_proto_host_sdk")
